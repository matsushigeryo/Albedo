<EnemyScript name="hoge">

    <Parallel mode="Join">
        <!-- 移動 -->
        <Task>
            <Repeat count="40">
                <MoveBy dx="0" dy="2" />
                <Wait frames="1" />
            </Repeat>

            <Wait frames="160" />

            <Repeat count="40">
                <MoveBy dx="0" dy="-2" />
                <Wait frames="1" />
            </Repeat>
        </Task>

        <!-- 攻撃 -->
        <Task>
            <Wait frames="60" />
            <Repeat count="5">
                <Repeat count="10">
                    <GetRandom name="angle" min="0" max="360" />
                    <GetRandom name="speed" min="1.0" max="1.5" />
                    <FireNWay way_count="1" speed="$speed" base_angle="$angle" shape="SmallCircle" color="Blue" />
                </Repeat>
                <Wait frames="20" />
            </Repeat>
        </Task>
    </Parallel>

    <KillEnemy />

</EnemyScript>