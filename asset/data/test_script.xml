<EnemyScript name="TestScript">
	<Wait frames="30" />

	<Repeat count="100">
		<GetRandom name="base_angle" min="-8" max="8" />
		<Repeat count="5">
			<AddVar name="base_angle" value="2" />
			<GetRandom name="speed" min="0.2" max="1.2" />
			<FireNWay way_count="16" speed="$speed" angle_range="360" base_angle="$base_angle" />
		</Repeat>
		
		<Wait frames="10" />
	</Repeat>

	<Print message="プログラム終了" />
</EnemyScript>