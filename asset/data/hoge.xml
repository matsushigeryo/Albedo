<EnemyScript name="hoge">

    <Parallel mode="Join">
        <!-- 移動 -->
        <Task>
            <Repeat count="40">
                <MoveBy dx="0" dy="2" />
                <Wait frames="1" />
            </Repeat>

            <Wait frames="160" />

            <Repeat count="40">
                <MoveBy dx="0" dy="-2" />
                <Wait frames="1" />
            </Repeat>
        </Task>

        <!-- 攻撃 -->
        <Task>
            <Wait frames="60" />
            <Repeat count="5">
                <SetVar name="speed" value="2" />
                <GetAngleToPlayer name="angle" />
                <Repeat count="5">
                    <FireNWay way_count="1" speed="$speed" base_angle="$angle" shape="SmallCircle" color="Red" />
                    <AddVar name="speed" value="0.2" />
                    <Wait frames="2" />
                </Repeat>
                <Wait frames="60" />
            </Repeat>
        </Task>
    </Parallel>

    <KillEnemy />

</EnemyScript>